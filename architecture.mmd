flowchart LR
    User["Field researcher"]
    ExternalID["Microsoft Entra External ID<br/>email OTP; API access token"]
    Mobile["Flutter client<br/>planned; not in repository"]
    API["FastAPI API<br/>token validation; upload/status"]
    Worker["Queue worker<br/>FASTQ QC; retry/poison handling"]
    Blob["Private Blob Storage<br/>sample, metadata, QC result"]
    Queue["Azure Storage Queue<br/>sample-jobs + poison queue"]
    ACR["Azure Container Registry<br/>admin disabled"]
    AKS["Azure Kubernetes Service<br/>API + worker"]
    Monitor["Log Analytics / Container Insights"]
    Terraform["Terraform AKS foundation<br/>opt-in; not applied"]
    Repo["GitHub repository"]
    CI["GitHub Actions CI<br/>tests, scans, build, IaC checks"]
    Deploy["Manual release workflow<br/>Azure OIDC + protected environment"]
    Runner["Self-hosted runner<br/>stable egress; pangolin-aks label"]
    GPU["Optional GPU batch hook<br/>no scientific image supplied"]
    Local["Local development<br/>FastAPI + Azure CLI credential"]

    User --> Mobile
    Mobile -.->|"Authorization Code + PKCE"| ExternalID
    Mobile -.->|"Bearer access token"| API
    ExternalID -->|"OIDC issuer/JWKS"| API
    API -->|"Managed identity: blob access"| Blob
    API -->|"Managed identity: queue send"| Queue
    Queue --> Worker
    Worker -->|"Managed identity: blob + queue processing"| Blob
    Worker -->|"acknowledge or poison"| Queue
    AKS --> API
    AKS --> Worker
    AKS --> Monitor
    ACR -->|"image pull"| AKS
    Terraform -.->|"provisions when explicitly enabled"| AKS
    Terraform -.-> Blob
    Terraform -.-> Queue
    Terraform -.-> ACR
    Terraform -.-> Monitor
    Terraform -.->|"OIDC workload identities"| API
    Terraform -.->|"OIDC workload identities"| Worker
    Terraform -.-> GPU
    Repo --> CI
    Repo --> Deploy
    Deploy --> Runner
    Runner -->|"Azure OIDC; build/push + Helm upgrade"| ACR
    Runner -->|"kubelogin + Helm"| AKS
    Local --> API
    Local -->|"DefaultAzureCredential"| Blob
    Local -->|"DefaultAzureCredential"| Queue

    classDef planned stroke-dasharray: 5 5;
    classDef notDeployed fill:#fff3cd,stroke:#b88a00,stroke-width:2px;
    class Mobile,GPU planned;
    class AKS,Blob,Queue,ACR,Monitor,Terraform,Deploy,Runner notDeployed;
