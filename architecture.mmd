flowchart LR
    Browser["Browser<br/>Pangolin Field Lab"]
    ExternalID["Microsoft Entra External ID<br/>customer tenant; email sign-in"]
    DNS["Azure public DNS<br/>canadacentral.cloudapp.azure.com"]
    LB["Azure Standard Load Balancer<br/>public IP; ports 80 and 443"]

    subgraph RG["Azure subscription · rg-pangolin-aks-interview · Canada Central"]
        subgraph AKS["AKS · Azure CNI overlay · two CPU nodes"]
            Proxy["Caddy proxy · 1 replica<br/>HTTPS / Let's Encrypt; ephemeral certificate storage"]
            Service["API ClusterIP service<br/>port 8000"]
            API["FastAPI and browser assets<br/>2 replicas"]
            Worker["FASTQ QC worker<br/>1 replica"]
            Proxy --> Service --> API
        end
        Blob["Private Blob container<br/>samples, metadata and QC reports"]
        Jobs["Storage Queue<br/>sample-jobs"]
        Poison["Storage Queue<br/>sample-jobs-poison"]
        ACR["Azure Container Registry<br/>Basic; admin disabled"]
        APIIdentity["API managed identity"]
        WorkerIdentity["Worker managed identity"]
        Logs["Log Analytics<br/>Container Insights"]
    end

    Browser -->|"Authorization code + PKCE"| ExternalID
    Browser -->|"HTTPS; bearer token for API calls"| DNS --> LB --> Proxy
    ExternalID -.->|"issuer and signing keys"| API
    API -->|"write and read owner-scoped data"| Blob
    API -->|"enqueue jobs"| Jobs
    Worker -->|"poll and acknowledge"| Jobs
    Worker -->|"failed jobs"| Poison
    Worker -->|"read samples; write QC reports"| Blob
    API -.->|"federated workload identity"| APIIdentity
    Worker -.->|"federated workload identity"| WorkerIdentity
    APIIdentity -.->|"scoped Storage RBAC"| Blob
    APIIdentity -.->|"scoped Storage RBAC"| Jobs
    WorkerIdentity -.->|"scoped Storage RBAC"| Blob
    WorkerIdentity -.->|"scoped Storage RBAC"| Jobs
    WorkerIdentity -.->|"scoped Storage RBAC"| Poison
    ACR -->|"kubelet image pull"| AKS
    AKS -->|"container logs"| Logs

    Repo["GitHub repository"]
    CI["GitHub Actions CI<br/>tests, scans, build and IaC checks"]
    Operator["Operator<br/>Terraform, Docker and Helm"]
    Cleanup["Scheduled GitHub Actions cleanup<br/>15 Nov 2026, 6 p.m. MST; OIDC managed identity"]
    Repo --> CI
    Repo --> Operator
    Operator -->|"build and push"| ACR
    Operator -->|"Helm release"| AKS
    Operator -->|"kubectl: proxy and public service"| Proxy
    Operator -->|"provision infrastructure"| RG
    Repo --> Cleanup
    Cleanup -.->|"delete resource group and uploaded data"| RG
